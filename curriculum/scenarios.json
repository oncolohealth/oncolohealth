    {"id": "spec-route-bone-xray", "family": "specialist-kinds", "lineage_group": "route-bone-xray-features", "split": "train_candidate",
     "user": "Which models can I run right now to get features from bone X-rays?",
     "turns": [[{"name": "route_models", "arguments": {"task": "feature_extraction", "modality": "xray", "anatomy": "bone"}}]]},
    {"id": "spec-bone-segmentation", "family": "specialist-kinds", "lineage_group": "bone-segmentation-absent", "split": "train_candidate",
     "user": "Is there a model here that can outline bone tumors on a radiograph?",
     "turns": [[{"name": "route_models", "arguments": {"task": "brain_tumor_segmentation", "modality": "xray", "anatomy": "bone"}},
                {"name": "search_catalog", "arguments": {"query": "segmentation", "record_type": "model"}}]]},
    {"id": "spec-detector-not-probability", "family": "specialist-kinds", "lineage_group": "lung-detector-semantics", "split": "train_candidate",
