+"""SYNTHETIC files and mocked embeddings only; no cancer data or model loading."""
+
+import copy
+import hashlib
+import importlib.util
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from cancer_workbench.learning.feature_identity import SCHEMA, binding_digest, measure_inputs, validate_cached_inputs
+
+
+class BindingFixture(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.rows = []
+        for i, body in enumerate((b"synthetic first image bytes", b"synthetic second image bytes")):
+            name = f"image-{i}.bin"
+            (self.root / name).write_bytes(body)
+            self.rows.append({"sample_id": f"s{i}", "file": name, "sha256": hashlib.sha256(body).hexdigest()})
+
+    def cache(self):
+        measured = measure_inputs(self.rows, self.root)
+        return {"sample_ids": [r["sample_id"] for r in measured], "image_sha256": [r["sha256"] for r in measured],
+                "input_binding_schema": SCHEMA, "input_content_sha256": binding_digest(measured),
+                "features": SimpleNamespace(shape=(len(measured), 2))}
+
+
+class InputBindingTests(BindingFixture):
+    def test_measured_roundtrip_and_no_optional_identity_metadata(self):
+        measured = measure_inputs(self.rows, self.root)
+        self.assertEqual(set(measured[0]), {"sample_id", "sha256"})
+        self.assertIsNone(validate_cached_inputs(self.cache(), self.rows, self.root))
+
+    def test_replaced_file_rejects_old_cache_even_with_updated_manifest_hash(self):
+        cached = self.cache()
+        body = b"synthetic replacement"
+        (self.root / self.rows[0]["file"]).write_bytes(body)
+        self.rows[0]["sha256"] = hashlib.sha256(body).hexdigest()
+        with self.assertRaisesRegex(ValueError, "current image IDs and bytes"):
+            validate_cached_inputs(cached, self.rows, self.root)
+
+    def test_no_declared_hash_still_binds_measured_bytes(self):
+        self.rows = [dict(r, sha256="") for r in self.rows]
+        cached = self.cache()
+        (self.root / self.rows[0]["file"]).write_bytes(b"replacement without a declaration")
+        with self.assertRaises(ValueError):
+            validate_cached_inputs(cached, self.rows, self.root)
+
+    def test_declared_hash_drift_and_malformed_hash_fail(self):
+        for value in ("0" * 64, "invalid", 5, True):
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                measure_inputs([dict(self.rows[0], sha256=value)], self.root)
+
+    def test_duplicate_or_blank_source_ids_fail(self):
+        for rows in ([], [self.rows[0], self.rows[0]], [dict(self.rows[0], sample_id="")],
+                     [dict(self.rows[0], sample_id=" s0")], [dict(self.rows[0], sample_id=1)]):
+            with self.subTest(rows=rows), self.assertRaises(ValueError):
+                measure_inputs(rows, self.root)
+
+    def test_missing_file_is_explicit_without_exporting_path(self):
+        secret = "synthetic-private-file-name.bin"
+        with self.assertRaises(ValueError) as caught:
+            measure_inputs([dict(self.rows[0], file=secret)], self.root)
+        self.assertNotIn(secret, str(caught.exception))
+        self.assertNotIn(str(self.root), str(caught.exception))
+
+    def test_absolute_parent_windows_and_symlink_escape_fail(self):
+        with tempfile.TemporaryDirectory() as outside:
