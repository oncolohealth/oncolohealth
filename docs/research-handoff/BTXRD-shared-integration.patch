+        image = Image.new("RGB", (8, 8))
+        exif = Image.Exif()
+        exif[0x013B] = "PRIVATE-SYNTHETIC-AUTHOR"
+        buffer = io.BytesIO()
+        image.save(buffer, format="JPEG", exif=exif)
