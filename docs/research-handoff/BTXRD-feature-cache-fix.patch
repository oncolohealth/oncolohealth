+    def test_all_four_cache_readers_refuse_legacy_and_stale_before_work(self):
+        from contextlib import ExitStack
+        from cancer_workbench.adapters import encoder
+        from cancer_workbench.experiments import btxrd_baseline, btxrd_source_shift, btxrd_near_duplicates, explore
+        from cancer_workbench.learning import features, heads
+
+        target = self.root / "legacy.npz"
+        self.legacy(target)
+        stale = self.root / "stale.npz"
+        self.extract(stale)
+        changed = b"synthetic source changed before consumer entry"
+        (self.root / self.rows[0]["file"]).write_bytes(changed)
+        self.rows[0]["sha256"] = hashlib.sha256(changed).hexdigest()
+        manifest = self.root / "manifest.csv"
+        manifest.write_text("synthetic manifest bytes")
+        for kind, cache_file, expected_error in (("legacy", target, "supported image binding"),
+                                                  ("stale", stale, "current image IDs and bytes")):
+            for module in (btxrd_baseline, btxrd_source_shift, btxrd_near_duplicates, explore):
+                with self.subTest(reader=module.__name__, cache_kind=kind), ExitStack() as stack:
+                    stack.enter_context(patch.object(module, "read_manifest", return_value=copy.deepcopy(self.rows)))
+                    stack.enter_context(patch.object(module, "RAW_DIR", self.root))
+                    stack.enter_context(patch.object(encoder, "revision", return_value="a" * 40))
+                    stack.enter_context(patch.object(features, "cache_path", return_value=cache_file))
+                    extract = stack.enter_context(patch.object(features, "extract_features"))
+                    fit = stack.enter_context(patch.object(heads, "train_feature_head"))
+                    rank = stack.enter_context(patch.object(btxrd_near_duplicates, "pair_scores"))
+                    if module is explore:
+                        call = lambda: module._refit(self.root, {"encoder": "rad-dino", "endpoint": "three_class", "protocol": "synthetic"})
+                    else:
+                        stack.enter_context(patch.object(module, "MANIFEST_PATH", manifest))
+                        if module is not btxrd_near_duplicates:
+                            stack.enter_context(patch.object(module, "_git_revision", return_value="synthetic"))
+                        kwargs = {"out_dir": self.root / module.__name__.split(".")[-1]}
+                        if module is not btxrd_near_duplicates:
+                            kwargs["encoders"] = ("rad-dino",)
+                        if module is btxrd_source_shift:
+                            kwargs["variants"] = ("pad",)
+                        call = lambda: module.run(**kwargs)
+                    with self.assertRaisesRegex(ValueError, expected_error):
+                        call()
+                    extract.assert_not_called()
+                    fit.assert_not_called()
+                    rank.assert_not_called()
