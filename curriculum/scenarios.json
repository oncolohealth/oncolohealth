    {"id": "spec-risk-model", "family": "specialist-kinds", "lineage_group": "risk-model-absent", "split": "development",
     "user": "I need a bone cancer risk model that gives each patient a percentage. What do we have?",
     "turns": [[{"name": "search_catalog", "arguments": {"query": "risk"}}, {"name": "get_workflow", "arguments": {"id": "choose-specialist-type"}}]]},
    {"id": "spec-embed-ask-malignant", "family": "specialist-kinds", "lineage_group": "embed-btxrd-rad-dino", "split": "train_candidate",
